# Local Worker environment: copy this file to .dev.vars (never commit .dev.vars).
# Leave AI/mail unset for a source-only local demo. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Set an actual model ID available to YOUR API account with Responses + structured output support.
# gpt-6-astra is the hosted demonstration's configuration, not a promised public API entitlement.
OPENAI_MODEL=
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=Site administrator
# Generate interactively: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Optional: create your own provider key and verify a sender domain before sending mail.
RESEND_API_KEY=
MAIL_FROM=
# Optional trusted Sites reviewer IDs; separate from the standalone administrator session.
COMMITTEE_REVIEWER_IDS=
